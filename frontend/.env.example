# URL du backend. Côté Vite, toute variable qui commence par VITE_ est exposée au bundle.
# En local, le backend tourne sur :3000 ou :3001 (compose). Laisser vide = fallback local.
VITE_API_URL=http://localhost:3000

# Firebase Web SDK — config publique (pas un secret, mais à isoler dans .env.local).
# À récupérer dans la console Firebase :
# Project settings → General → Your apps → Web app → SDK setup → Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=findmycar-354b0.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=findmycar-354b0
VITE_FIREBASE_APP_ID=
